# Copy this file to .env and fill in the values before running in production.
# In development, everything below has a safe fallback (see src/config.ts),
# so `npm run dev` works with zero configuration.

# ---- Server ---------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ---- x402 monetization ------------------------------------------------------
# Wallet address (Base L2, EVM format) that receives USDC micropayments.
# REQUIRED in production — there is no safe default for where money goes.
RECIPIENT_WALLET=0xYourWalletAddressHere

# Price per verify_package call once the free tier is exhausted, in atomic
# USDC units (USDC has 6 decimals). 3000 = $0.003.
PRICE_ATOMIC_USDC=3000

# Number of free calls granted per wallet/IP before the x402 gate kicks in.
# Kept small deliberately: caller identity here isn't cryptographically
# verified (see src/config.ts), so a generous limit is cheap to abuse by
# rotating the Authorization header. This bounds how much that costs you.
FREE_TIER_LIMIT=5

# ---- On-chain payment verification (Base mainnet) --------------------------
# Public endpoint by default — fine for low/medium volume, no uptime SLA.
# Swap in a dedicated provider (Alchemy, Infura, QuickNode) once real
# traffic depends on this being reliable.
BASE_RPC_URL=https://mainnet.base.org

# How old (seconds) a settled payment tx may be and still count as proof
# for the current call. Bounds the "replay an old unrelated transfer"
# window without requiring a tighter, UX-hostile deadline.
PAYMENT_MAX_AGE_SECONDS=600

# ---- Rate-limit / freemium counter (in-memory LRU) -------------------------
RATE_LIMIT_CACHE_MAX_ENTRIES=50000
RATE_LIMIT_CACHE_TTL_MS=86400000

# ---- Oracle tuning ----------------------------------------------------------
UPSTREAM_TIMEOUT_MS=8000
NEW_PACKAGE_THRESHOLD_DAYS=30
TYPOSQUAT_MAX_DISTANCE=2
